if(NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "VMProtect did not produce ${INPUT}")
endif()
file(SIZE "${INPUT}" output_size)
if(output_size EQUAL 0)
    message(FATAL_ERROR "VMProtect produced an empty file: ${INPUT}")
endif()
if(MAX_BYTES GREATER 0 AND output_size GREATER MAX_BYTES)
    message(FATAL_ERROR "Protected DLL exceeds the loader limit: ${output_size} > ${MAX_BYTES} bytes")
endif()
file(COPY_FILE "${INPUT}" "${OUTPUT}" ONLY_IF_DIFFERENT)
